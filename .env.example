# ============================================================================
# VoiceLab AI v3.3.0 — Environment Variables Template (.env.example)
# Copy to .env for local development: cp .env.example .env
# NEVER commit your actual .env file or real API keys to Git.
# ============================================================================

# GEMINI_API_KEY: Required for Cloud Persona-Conditioned TTS & Multilingual ASR.
# In Google AI Studio, this is injected automatically from the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public origin URL where this application is hosted (used for strict CORS).
# In Google AI Studio, this is injected automatically at runtime.
APP_URL="MY_APP_URL"

# ----------------------------------------------------------------------------
# Optional Server & Frontend Overrides (Automatically configured if omitted)
# ----------------------------------------------------------------------------
# PORT="3000"
# NODE_ENV="production"
# SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_BYTES_OF_RANDOM_HEX_ENTROPY"
# VITE_API_BASE_URL=""
